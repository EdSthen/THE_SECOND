    for (unsigned value : sample_values) {
        double prob_regular = value_probability(value, *regular_dice_100, NUM_ROLLS);
        double prob_penalty = value_probability(value, *penalty_dice_100, NUM_ROLLS);
        double prob_bonus = value_probability(value, *bonus_dice_100, NUM_ROLLS);
        
        std::cout << value << "\t | " << prob_regular 
                  << " | " << prob_penalty 
                  << " | " << prob_bonus << std::endl;
